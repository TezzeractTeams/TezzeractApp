{
  "name": "tezzeract-app",
  "version": "1.0.1",
  "description": "Multi-tab platform with Talent Search, Social Media, and Chat",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "dev:app": "pnpm --filter @tezzeract/tezzeract-app dev",
    "dev:gateway": "pnpm --filter @tezzeract/gateway dev",
    "build:app": "pnpm --filter @tezzeract/tezzeract-app build",
    "build:gateway": "pnpm --filter @tezzeract/gateway build"
  },
  "keywords": [
    "monorepo",
    "react",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.1",
  "devDependencies": {
    "turbo": "^2.10.7"
  }
}
