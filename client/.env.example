# API Configuration (use /api in dev so OIDC cookies flow through the Vite proxy)
# VITE_API_URL=/api

# Vercel production build: Express API origin (no trailing slash), e.g. Render service URL
# API_PROXY_ORIGIN=https://your-api.onrender.com

# Supabase Configuration (optional - if using Supabase directly from client)
# VITE_SUPABASE_URL=your-supabase-url
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
